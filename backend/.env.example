
NODE_ENV=production
PORT=5000

# PostgreSQL Database (local or cloud-hosted)
DATABASE_URL="postgresql://postgres:123456@127.0.0.1:5432/gymmis?schema=public"

# JWT Authentication
JWT_SECRET="replace_with_a_strong_256_bit_hex_or_long_random_secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace_with_a_strong_refresh_secret"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS
CORS_ORIGIN="https://your-domain.com,https://www.your-domain.com"

# Gym assistant / RAG
OPENAI_API_KEY=""
GEMINI_API_KEY=""
RAG_LLM_API_KEY=""
RAG_EMBEDDING_API_KEY=""
RAG_LLM_BASE_URL="https://api.openai.com/v1"
RAG_LLM_MODEL="gpt-4o-mini"
RAG_EMBEDDING_PROVIDER="openai"
RAG_EMBEDDING_BASE_URL="https://api.openai.com/v1"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_EMBEDDING_DIMENSIONS="1536"
RAG_VECTOR_STORE="pgvector"
RAG_CHROMA_URL="http://localhost:8000"
RAG_DATA_DIR="data"
UPLOADS_DIR="uploads"
